{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "engineering_snapshot_not_final_test"
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[KBO][0-9]{2}$"
          },
          "source_kind": {
            "enum": [
              "public_report",
              "original_code",
              "recorded_telemetry"
            ]
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "repository": {
            "type": [
              "string",
              "null"
            ]
          },
          "system": {
            "type": [
              "string",
              "null"
            ]
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "commits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "buggy": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "fixed": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": []
          },
          "incident_group": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "enum": [
              "regression",
              "development",
              "final_test",
              "excluded"
            ]
          },
          "evidence_tier": {
            "enum": [
              "original_report",
              "original_code_unexecuted",
              "reproduced_code",
              "recorded_telemetry"
            ]
          },
          "overlap": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "training": {
                "enum": [
                  "clear",
                  "overlap",
                  "unknown"
                ]
              },
              "index": {
                "enum": [
                  "clear",
                  "overlap",
                  "unknown"
                ]
              },
              "prior_evaluation": {
                "enum": [
                  "clear",
                  "overlap",
                  "unknown"
                ]
              }
            },
            "required": [
              "training",
              "index",
              "prior_evaluation"
            ]
          },
          "label_status": {
            "enum": [
              "pending",
              "adjudicated",
              "ambiguous"
            ]
          },
          "label_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reviewer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "human",
                    "agent"
                  ]
                },
                "approved": {
                  "type": "boolean"
                },
                "label_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "reviewer_id",
                "kind",
                "approved",
                "label_sha256"
              ]
            }
          },
          "input_review": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "terms_status": {
            "enum": [
              "local_only_pending_review",
              "approved",
              "rejected"
            ]
          },
          "reproduction_status": {
            "enum": [
              "not_run",
              "report_only",
              "telemetry_downloaded",
              "fail_before_pass_after",
              "blocked_environment"
            ]
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "failure_classifier",
                "candidate_ranker",
                "incident_similarity",
                "trace_anomaly",
                "patch_selector"
              ]
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "role": {
                  "enum": [
                    "input",
                    "oracle",
                    "environment",
                    "raw"
                  ]
                },
                "member": {
                  "type": "string",
                  "minLength": 1
                },
                "archive_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "compressed_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "compressed_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "crc32": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}$"
                },
                "row_id": {
                  "type": "string",
                  "minLength": 1
                },
                "projection": {
                  "enum": [
                    "github_report_body",
                    "canonical_commit_json",
                    "csv_instruction"
                  ]
                },
                "derived_from": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "url",
                "sha256",
                "bytes",
                "role"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "source_kind",
          "source_url",
          "repository",
          "system",
          "task_id",
          "commits",
          "incident_group",
          "split",
          "evidence_tier",
          "overlap",
          "label_status",
          "label_sha256",
          "reviews",
          "input_review",
          "terms_status",
          "reproduction_status",
          "capabilities",
          "files",
          "notes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "status",
    "cases"
  ]
}
