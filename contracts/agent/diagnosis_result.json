{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raphael.dev/contracts/agent/diagnosis_result.json",
  "title": "DiagnosisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "hypotheses",
    "confidence",
    "selected_hypothesis_id",
    "supporting_evidence_ids",
    "analyzer",
    "diagnosed_at"
  ],
  "properties": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "failure_class"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["supported", "blocked", "unknown"]
        },
        "failure_class": {
          "type": "string",
          "description": "Aligned with sandbox failure_signature.class when known",
          "enum": [
            "invalid_missing_config",
            "bad_image_reference",
            "probe_misconfiguration",
            "resource_constraint",
            "service_port_mismatch",
            "helm_kustomize_render_error",
            "deployment_regression",
            "policy_blocked",
            "unknown",
            "healthy"
          ]
        },
        "blocked_reason": {
          "type": ["string", "null"],
          "description": "Set when category is blocked"
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "rank",
          "statement",
          "confidence",
          "supporting_evidence_ids",
          "contradicting_evidence_ids"
        ],
        "properties": {
          "hypothesis_id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "statement": {
            "type": "string",
            "description": "Short structured claim; not free-form diagnosis alone"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "failure_class": {
            "type": "string"
          },
          "expected_signature_key": {
            "type": ["string", "null"],
            "description": "Sandbox failure_signature.key expected on reproduce"
          },
          "supporting_evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contradicting_evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "candidate_fix_hint": {
            "type": ["string", "null"],
            "description": "Optional path/action hint for patch node; not a patch itself"
          }
        }
      }
    },
    "selected_hypothesis_id": {
      "type": ["string", "null"],
      "description": "Null when confidence below threshold or category blocked/unknown"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence of the selected hypothesis (0 if none selected)"
    },
    "confidence_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["deterministic", "llm", "hybrid", "stub"]
        },
        "version": { "type": "string" }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Optional prose; structured fields above drive control flow"
    },
    "diagnosed_at": { "type": "string", "format": "date-time" }
  }
}
