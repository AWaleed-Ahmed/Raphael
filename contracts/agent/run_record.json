{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raphael.dev/contracts/agent/run_record.json",
  "title": "RunRecord",
  "description": "Durable inspectable agent run state (LangGraph state object). Compatible with sandbox failure_signature, validation_results, and result_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "tenant_id",
    "status",
    "created_at",
    "updated_at",
    "trigger",
    "repository",
    "commit_sha",
    "evidence",
    "candidate_patches",
    "validation_results",
    "policy_decisions",
    "audit_events",
    "attempt_count",
    "sandbox_mode"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "audit_id": {
      "type": "string",
      "description": "Immutable audit id for the run (may equal run_id in Phase 0)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "success_draft_pr_ready",
        "success_fix_proposed",
        "escalated",
        "failed_closed",
        "cancelled"
      ],
      "description": "Terminals: success_draft_pr_ready (CI draft PR) | success_fix_proposed (Issues snippet) | escalated | failed_closed | cancelled (I0 human cancel)"
    },
    "parent_run_id": {
      "type": ["string", "null"],
      "description": "I0: set when this run was created by retry from another run"
    },
    "current_node": {
      "type": ["string", "null"],
      "enum": [
        "ingest",
        "evidence",
        "diagnose",
        "reproduce",
        "patch",
        "validate",
        "publish_or_escalate",
        null
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "received_at"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "github_workflow_run",
            "github_check_run",
            "github_deployment_status",
            "github_issue",
            "k8s_workload",
            "fixture",
            "manual",
            "manual_ui",
            "manual_ide",
            "manual_github"
          ],
          "description": "manual retained for back-compat; prefer manual_ui|manual_ide|manual_github for I0"
        },
        "event_id": { "type": "string" },
        "received_at": { "type": "string", "format": "date-time" },
        "raw_ref": {
          "type": "string",
          "description": "Pointer to stored raw event; not the full payload"
        }
      }
    },
    "delivery_mode": {
      "type": "string",
      "enum": ["draft_pr", "issue_snippet"],
      "description": "Route A draft_pr vs Route B issue_snippet (human opens PR)"
    },
    "issue_number": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "GitHub issue number for Route B"
    },
    "issue_labels": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Labels present on the triggering issue"
    },
    "issue_title": { "type": ["string", "null"] },
    "issue_body": {
      "type": ["string", "null"],
      "description": "Bounded issue body used as evidence (may be truncated)"
    },
    "failure_class_hint": {
      "type": ["string", "null"],
      "description": "Optional raphael-failure-class from issue body for template path"
    },
    "issue_comment_url": {
      "type": ["string", "null"],
      "description": "URL of the fix-snippet comment posted on Route B"
    },
    "fix_rules": {
      "description": "Preset or derived Route B fix constraints",
      "$ref": "fix_rules.json"
    },
    "failure_fingerprint": {
      "type": "string",
      "description": "FR-003 dedupe key (tenant|repo|commit|environment|provisional_failure_key)"
    },
    "correlation": {
      "type": "object",
      "description": "FR-004 correlated deployment context derived at ingest",
      "additionalProperties": false,
      "properties": {
        "deployment_config_path": { "type": ["string", "null"] },
        "namespace": { "type": ["string", "null"] },
        "workload": { "type": ["string", "null"] },
        "workflow_name": { "type": ["string", "null"] },
        "check_name": { "type": ["string", "null"] },
        "provisional_failure_key": { "type": ["string", "null"] }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "clone_url": { "type": "string" }
      }
    },
    "commit_sha": { "type": "string", "minLength": 7 },
    "target_environment": { "type": ["string", "null"] },
    "affected_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "namespace": { "type": "string" }
        }
      }
    },
    "workspace_path": {
      "type": ["string", "null"],
      "description": "Local/controller workspace for sandbox deploy (fixture path in Phase 0)"
    },
    "manifests": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["yaml", "helm", "kustomize"]
        },
        "path": { "type": "string" },
        "fixed_path": {
          "type": "string",
          "description": "Optional fixed manifests path for stub validate path"
        },
        "chart": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" }
        },
        "overlay": { "type": "string" },
        "release_name": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence_item.json" }
    },
    "redaction_report": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "items_redacted": { "type": "integer", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "failure_signature": {
      "description": "Observed or expected signature (sandbox shape)",
      "$ref": "../sandbox/failure_signature.json"
    },
    "diagnosis": { "$ref": "diagnosis_result.json" },
    "sandbox_id": { "type": ["string", "null"] },
    "sandbox_mode": {
      "type": "string",
      "enum": ["live", "recorded_stub", "skipped"],
      "description": "Whether sandbox HTTP was live, recorded offline stubs, or skipped"
    },
    "reproduction_result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reproduced": { "type": "boolean" },
        "matched_expected": { "type": ["boolean", "null"] },
        "signature_key": { "type": ["string", "null"] },
        "artifact_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message": { "type": "string" }
      }
    },
    "candidate_patches": {
      "type": "array",
      "items": { "$ref": "patch_proposal.json" }
    },
    "active_patch_id": { "type": ["string", "null"] },
    "validation_results": {
      "type": "array",
      "items": { "$ref": "../sandbox/validation_results.json" }
    },
    "result_id": {
      "type": ["string", "null"],
      "description": "Frozen sandbox validated_fix_record.result_id; required before publish"
    },
    "validated_fix_record": {
      "description": "Optional copy/pointer payload of frozen sandbox record",
      "$ref": "../sandbox/validated_fix_record.json"
    },
    "policy_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "decision", "at"],
        "properties": {
          "rule": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["allow", "deny", "escalate"]
          },
          "message": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "attempt_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis", "patch"],
      "properties": {
        "diagnosis": { "type": "integer", "minimum": 0 },
        "patch": { "type": "integer", "minimum": 0 }
      }
    },
    "token_and_cost_usage": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "escalation_report": { "$ref": "escalation_report.json" },
    "publish": {
      "description": "Draft PR publication outcome (Phase 3+)",
      "$ref": "publish_result.json"
    },
    "pull_request_url": {
      "type": ["string", "null"],
      "description": "Draft PR URL after publish; dry-run uses a documented placeholder compare URL"
    },
    "pull_request_number": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "I0 correlation: GitHub pull request number when known"
    },
    "pull_request_branch": {
      "type": ["string", "null"],
      "description": "Agent-owned branch pushed for the draft PR"
    },
    "budget_snapshot": {
      "description": "Budget caps captured at run start",
      "$ref": "budget_snapshot.json"
    },
    "terminal_reason": { "type": ["string", "null"] },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" },
          "node": { "type": "string" }
        }
      }
    },
    "audit_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "node", "event"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "node": { "type": "string" },
          "event": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
