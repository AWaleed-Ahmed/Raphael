# Copy this file to .env and fill in the empty values.
# Load it locally with: set -a; source .env; set +a

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Or use Supabase's newer backend-only key: SUPABASE_SECRET_KEY=""

# Optional smoke-test identity
RAPHAEL_CLIENT_ID=demo-client
RAPHAEL_CLIENT_NAME="Demo Client"
# Optional when the client catalog is reachable; otherwise set explicitly for telemetry scope.
RAPHAEL_COMPANY_ID=""
# Local incident retrieval also requires an explicit operator-bound run tenant.
# Set all three IDs to the approved index owner; request fields cannot grant access.
# RAPHAEL_AGENT_TENANT_ID=your-authenticated-tenant

# Healthy catalog is deferred from pilot claims and disabled by default.
# Opt-in also requires BOTH trusted backend RAPHAEL_COMPANY_ID and RAPHAEL_CLIENT_ID.
RAPHAEL_HEALTHY_CATALOG_ENABLED=0
